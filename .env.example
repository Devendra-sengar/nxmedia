# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SENDER_EMAIL: Email ID from which both the notification and receipt emails are dispatched
SENDER_EMAIL="prathamjoshi355@gmail.com"

# RECIPIENT_EMAIL: Email ID where the inquiry notification arrives (owner's email)
RECIPIENT_EMAIL="prathamjoshi355@gmail.com"

# RECEIPT_EMAIL: Email ID that also receives a copy of the official receipt
RECEIPT_EMAIL="prathamjoshi355@gmail.com"

# SMTP Configuration (Optional: uses real SMTP when provided, otherwise development test transport)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="prathamjoshi355@gmail.com"
SMTP_PASS="your_gmail_app_password"
